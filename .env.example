# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า

# Anthropic API Key — สร้างคำถาม + AI Judge
# ขอได้ที่ https://console.anthropic.com/
#
# dev (npm run dev): ใช้ VITE_ — Vite proxy ส่ง key ให้ Anthropic
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
#
# Docker / Cloud Run: ใช้บน server (ไม่ฝังใน JS ฝั่ง browser)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
