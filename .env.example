# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า

# --- Dify Chatbot (ค่าเริ่มต้นในแท็บรัน Test — ไม่ต้อง copy ทุกครั้ง) ---
DEFAULT_DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# --- สร้างคำถาม (Anthropic) ---
# https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- AI Judge ตรวจคำตอบ (OpenRouter) ---
# https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
